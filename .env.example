# Free key: https://console.groq.com/keys  (never commit the real .env)
GROQ_API_KEY=gsk_your_key_here

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# REWRITE_MODEL=openai/gpt-oss-20b
# TOP_K=4
# RATE_LIMIT_PER_MINUTE=12

# Set this to any long random string to enable GET /analytics (send it as X-Admin-Token)
ADMIN_TOKEN=
